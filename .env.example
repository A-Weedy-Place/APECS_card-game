# Server-only organiser credentials. Generate with scripts/admin-secrets.mjs.
# ADMIN_PASSWORD_HASH=<salt>:<scrypt digest>
# ADMIN_SESSION_SECRET=<random 32-byte hex>
# Legacy local test access only:
# ADMIN_TOKEN=replace-with-a-long-random-token
# Hosted storage: restricted apecs_server role through the Supabase transaction pooler.
# DATABASE_URL=postgresql://apecs_server.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
# Local SQLite is retained when DATABASE_URL is absent, but never allowed on Vercel.
# Optional: a URL reachable from attendees' phones, not localhost.
# NEXT_PUBLIC_GAME_URL=http://192.168.1.10:3000
# DATABASE_PATH=./data/game.sqlite
# Experimental local browser bridge (requires installed Edge + Playwright).
# Enabled by default in development; disabled by default in production.
# This is not an SDK licence or an event-ready integration.
# ENROADS_BROWSER_ENABLED=1
# ENROADS_BROWSER_CHANNEL=msedge
# Hosted experimental laptop queue. Requires its private schema migration and worker.
# MODEL_QUEUE_ENABLED=1
# Worker reads its separate restricted DATABASE_URL from ignored .env.worker.local.
